# Django Settings
ENV=development
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# Database
POSTGRES_DB=habit_db_dev
POSTGRES_USER=habit_user
POSTGRES_PASSWORD=habit_password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/1

# Email (development uses console backend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=dev@21days-habit.local
EMAIL_ENABLE_SEND=false

# Frontend URL
FRONTEND_URL=http://localhost:5173
